#include "client/ui/components/actions/app_button.h"

#include "ui/components/button.h"
#include "client/ui/components/tokens.h"

#include <functional>

namespace shooter {

using ::ui::components::Button;
using ::ui::components::ButtonProps;

// Authored as plain C++ (not JSX): ui::components::ButtonProps declares
// `children` BEFORE `style`, but the JSX lowering always appends `.children`
// last, which would emit `.style` before `.children` and trip
// -Werror=reorder-init-list. Hand-assembling ButtonProps lets us keep the
// designated initializers in declaration order. Children are plain expressions
// (props.children + the label fallback, mirroring screen_chrome's MenuButton),
// so there are no JSX child tags and no spurious comma-text nodes.
::ui::UiElement AppButton(const AppButtonProps &props) {
  // Wrap the no-arg semantic callbacks into the event-taking ui callbacks; the
  // host events are intentionally ignored (the semantic API is event-free).
  std::function<void(const ::ui::ActivationEvent &)> on_activate = {};
  if (props.on_press) {
    on_activate = [on_press = props.on_press](const ::ui::ActivationEvent &) {
      on_press();
    };
  }
  std::function<void(const ::ui::FocusEvent &)> on_focus = {};
  if (props.on_focus) {
    on_focus = [on_focus_cb = props.on_focus](const ::ui::FocusEvent &) {
      on_focus_cb();
    };
  }

  const char *a11y_label =
      props.accessibility_label ? props.accessibility_label : props.label;

  return ::ui::component(
      "Button",
      ButtonProps{
          .key = props.key,
          .id = props.control_id,
          .id_offset = props.control_offset,
          .disabled = props.disabled,
          .autofocus = props.default_focused,
          .accessibility = {.label = a11y_label},
          .on_focus = on_focus,
          .label = props.label,
          .on_activate = on_activate,
          .children = ::ui::children({
              props.children,
              props.children.count > 0 ? nullptr : props.label,
          }),
          .style = app_button_layout(props.size, props.selected),
          .style_override = app_button_variant_patch(props.variant),
      },
      Button);
}

} // namespace shooter
