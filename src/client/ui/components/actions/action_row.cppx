#include "client/ui/components/actions/action_row.h"

#include "ui/components/box.h"
#include "client/ui/components/tokens.h"

namespace shooter {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;

::ui::UiElement ActionRow(const ActionRowProps &props) {
  const ::ui::Style style = {
      .direction = ::ui::FlexDirection::Row,
      .align_items = ::ui::AlignItems::Start,
      .gap = 12.0f,
  };
  return <Box key={props.key} style={style}>
    {props.children}
  </Box>
}

} // namespace shooter
