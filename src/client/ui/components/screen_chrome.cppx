#include "screen_chrome.h"

#include "ui/components/box.h"
#include "ui/components/button.h"
#include "ui/components/dialog.h"
#include "ui/components/text.h"

namespace shooter {

using ::ui::children;
using ::ui::components::Box;
using ::ui::components::BoxProps;
using ::ui::components::Button;
using ::ui::components::ButtonProps;
using ::ui::components::Dialog;
using ::ui::components::DialogProps;
using ::ui::components::Text;
using ::ui::components::TextProps;

::ui::UiElement MenuScreenFrame(const MenuScreenFrameProps &props) {
  return <Box key={props.key} style={theme::menu_screen_frame_style()} visual={theme::menu_screen_frame_visual()}>
    {props.children}
  </Box>
}

::ui::UiElement GameScreenFrame(const GameScreenFrameProps &props) {
  return <Box key={props.key} style={theme::game_screen_frame_style()} visual={theme::game_screen_frame_visual()}>
    {props.children}
  </Box>
}

::ui::UiElement OverlayScreenFrame(const OverlayScreenFrameProps &props) {
  return <Dialog key={props.key} style={theme::overlay_screen_frame_style()} visual={theme::overlay_screen_frame_visual()}>
    {props.children}
  </Dialog>
}

::ui::UiElement CenteredOverlayFrame(const CenteredOverlayFrameProps &props) {
  return <Dialog key={props.key} style={theme::centered_overlay_frame_style()}>
    {props.children}
  </Dialog>
}

::ui::UiElement HeroPanel(const HeroPanelProps &props) {
  return <Box key={props.key} style={theme::hero_panel_style()} visual={theme::hero_panel_visual()}>
    {props.children}
  </Box>
}

::ui::UiElement OverlayPanel(const OverlayPanelProps &props) {
  return <Box key={props.key} style={theme::overlay_panel_style()} visual={theme::overlay_panel_visual()}>
    {props.children}
  </Box>
}

::ui::UiElement HeroTitle(const HeroTitleProps &props) {
  return <Text key={props.key} value={props.value} style={theme::hero_title_style()} visual={theme::hero_title_visual()} />
}

::ui::UiElement ScreenTitle(const ScreenTitleProps &props) {
  return <Text key={props.key} value={props.value} style={theme::screen_title_style()} visual={theme::screen_title_visual()} />
}

::ui::UiElement DialogTitle(const DialogTitleProps &props) {
  return <Text key={props.key} value={props.value} style={theme::dialog_title_style()} visual={theme::dialog_title_visual()} />
}

::ui::UiElement SubtitleText(const SubtitleTextProps &props) {
  return <Text key={props.key} value={props.value} style={theme::subtitle_style()} visual={theme::subtitle_visual()} />
}

::ui::UiElement ActionRow(const ActionRowProps &props) {
  return <Box key={props.key} style={theme::action_row_style()}>
    {props.children}
  </Box>
}

::ui::UiElement MenuButton(const MenuButtonProps &props) {
  return <Button
    key={props.key}
    id={props.id}
    idOffset={props.id_offset}
    disabled={props.disabled}
    autofocus={props.autofocus}
    label={props.label}
    onActivate={props.on_activate}
  >
    {props.children}
    {props.children.count > 0 ? nullptr : props.label}
  </Button>
}

} // namespace shooter
