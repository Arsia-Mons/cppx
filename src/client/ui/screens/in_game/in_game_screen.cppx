#include "in_game_screen.h"

#include <functional>
#include <memory>
#include <stdio.h>

#include "client/ui/callback_deps.h"
#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/hooks/use_navigation.h"
#include "client/ui/screens/in_game/components/hud_band.h"
#include "client/ui/screens/loadout/loadout_screen.h"
#include "client/ui/screens/pause/pause_screen.h"
#include "react.h"

namespace shooter {

using ::ui::children;

struct ShooterGameScreenProps {
  uint32_t unused = 0;
};

static const char *screen_entry_key(const char *prefix,
                                    client::ui::UiScreenEntryId entry_id) {
  char key[64] = {};
  snprintf(key, sizeof(key), "%s-%u", prefix, entry_id);
  return ::ui::copy_string(key);
}

static ::ui::UiElement
ShooterGameScreenView(const ShooterGameScreenProps &props) {
  (void)props;
  client::ui::Navigation navigation = client::ui::use_navigation();
  std::function<void()> open_pause = use_callback(
      [navigation] {
        if (navigation.push)
          navigation.push(std::make_unique<PauseScreen>());
      },
      client::ui::callback_deps(navigation.current_entry_id));
  std::function<void()> open_loadout = use_callback(
      [navigation] {
        if (navigation.push)
          navigation.push(std::make_unique<LoadoutScreen>());
      },
      client::ui::callback_deps(navigation.current_entry_id));

  if (!navigation.is_top)
    return ::ui::empty();

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Game}>
    <HudBand />
    <ActionRow key="actions">
      <AppButton key="pause" controlId="OpenPauseButton" label="Pause" onPress={open_pause} />
      <AppButton
        key="loadout"
        controlId="OpenLoadoutButton"
        label="Loadout"
        onPress={open_loadout}
      />
    </ActionRow>
  </ScreenLayout>
}

bool ShooterGameScreen::build_element(::ui::UiElementFrame &frame,
                                      ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("ShooterGameScreen", ShooterGameScreenProps{},
                         ShooterGameScreenView,
                         screen_entry_key("shooter-game", entry_id()));
  return true;
}

void ShooterGameScreen::build_ui() {}

} // namespace shooter
