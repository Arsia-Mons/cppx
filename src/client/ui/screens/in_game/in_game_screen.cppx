#include "in_game_screen.h"

#include <memory>
#include <stdio.h>

#include "client/ui/callback_deps.h"
#include "client/ui/client_ui.h"
#include "client/ui/components/hud_band.h"
#include "client/ui/components/screen_chrome.h"
#include "client/ui/internal/deferred_ui_mutation.h"
#include "client/ui/providers/shooter_provider.h"
#include "client/ui/screens/loadout/loadout_screen.h"
#include "client/ui/screens/pause/pause_screen.h"
#include "react.h"

namespace shooter {

using ::ui::children;

std::function<void()> use_start_match() {
  ShooterGame *game = use_shooter_game();
  client::ui::ScreenNavigator nav = client::ui::use_screen_navigator();
  client::ui::internal::DeferredUiMutationSink mutations =
      client::ui::internal::use_deferred_ui_mutations();
  return use_callback(
      [game, nav, mutations] {
        if (!nav.reset_to)
          return;
        if (game && mutations) {
          mutations.submit([game] { game->reset(); });
        }
        nav.reset_to(std::make_unique<ShooterGameScreen>());
      },
      client::ui::callback_deps(
          client::ui::callback_deps_ptr(game),
          client::ui::callback_deps_ptr(mutations.owner()),
          nav.current_entry_id));
}

struct ShooterGameScreenProps {
  uint32_t unused = 0;
};

static const char *screen_entry_key(const char *prefix,
                                    client::ui::UiScreenEntryId entry_id) {
  char key[64] = {};
  snprintf(key, sizeof(key), "%s-%u", prefix, entry_id);
  return ::ui::copy_string(key);
}

static ::ui::UiElement
ShooterGameScreenView(const ShooterGameScreenProps &props) {
  (void)props;
  bool is_top = client::ui::use_screen_is_top();
  std::function<void()> open_pause = use_push_pause_screen();
  std::function<void()> open_loadout = use_push_loadout_screen();

  if (!is_top)
    return ::ui::empty();

  return <GameScreenFrame key="root">
    <HudBand />
    <ActionRow key="actions">
      <MenuButton
        key="pause"
        id="OpenPauseButton"
        label="Pause"
        onActivate={[open_pause](const ::ui::ActivationEvent &) {
          if (open_pause)
            open_pause();
        }}
      />
      <MenuButton
        key="loadout"
        id="OpenLoadoutButton"
        label="Loadout"
        onActivate={[open_loadout](const ::ui::ActivationEvent &) {
          if (open_loadout)
            open_loadout();
        }}
      />
    </ActionRow>
  </GameScreenFrame>
}

bool ShooterGameScreen::build_element(::ui::UiElementFrame &frame,
                                      ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("ShooterGameScreen", ShooterGameScreenProps{},
                         ShooterGameScreenView,
                         screen_entry_key("shooter-game", entry_id()));
  return true;
}

void ShooterGameScreen::build_ui() {}

} // namespace shooter
