#include "main_menu_screen.h"

#include <stdio.h>

#include "client/ui/app_shell/client_ui.h"
#include "client/ui/components/actions/actions.h"
#include "client/ui/components/layout/layout.h"
#include "client/ui/components/surfaces/surfaces.h"
#include "client/ui/components/text/text.h"
#include "client/ui/app_shell/app_shell_provider.h"
#include "client/ui/screens/in_game/in_game_actions.h"
#include "client/ui/screens/options/options_actions.h"
#include "react.h"

namespace shooter {

using ::ui::children;

struct MainMenuScreenProps {
  uint32_t unused = 0;
};

static const char *screen_entry_key(const char *prefix,
                                    client::ui::UiScreenEntryId entry_id) {
  char key[64] = {};
  snprintf(key, sizeof(key), "%s-%u", prefix, entry_id);
  return ::ui::copy_string(key);
}

static ::ui::UiElement MainMenuScreenView(const MainMenuScreenProps &props) {
  (void)props;
  std::function<void()> start_match = use_start_match();
  std::function<void()> open_options = use_push_options_screen();
  std::function<void()> request_quit = client::ui::use_request_quit();
  bool is_top = client::ui::use_screen_is_top();

  // Yield the frame when an overlay (Options) is pushed on top. Visible screens
  // build top-first, so a base screen that keeps rendering paints OVER the
  // overlay above it. Every other screen follows this same guard.
  if (!is_top)
    return ::ui::empty();

  return <ScreenLayout key="root" variant={ScreenLayoutVariant::Menu}>
    <Panel key="panel" variant={PanelVariant::Hero}>
      <ScreenTitle key="title" variant={ScreenTitleVariant::Hero} value="Reference Shooter" />
      <ScreenSubtitle key="subtitle" value="SDL3 / retained UI flow" />
      <AppButton key="start" controlId="StartMatchButton" label="Start Match" onPress={start_match} />
      <AppButton key="options" controlId="OpenOptionsFromMainMenuButton" label="Options" onPress={open_options} />
      <AppButton key="quit" controlId="QuitButton" disabled={!request_quit} label="Quit" onPress={request_quit} />
    </Panel>
  </ScreenLayout>
}

bool MainMenuScreen::build_element(::ui::UiElementFrame &frame,
                                   ::ui::UiElement *out) {
  if (!out)
    return false;
  *out = ::ui::component("MainMenuScreen", MainMenuScreenProps{},
                         MainMenuScreenView,
                         screen_entry_key("main-menu", entry_id()));
  return true;
}

void MainMenuScreen::build_ui() {}

} // namespace shooter
