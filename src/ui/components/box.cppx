#include "box.h"

namespace ui::components {
namespace {

::ui::UiElement render_box(const BoxProps &props) {
  return <detail.Host kind = {::ui::HostKind::Box} key = {props.key} id =
              {props.id} idOffset = {props.id_offset} style =
                  {props.style} interaction = {detail::interaction_from_props(
                      props)} accessibility =
                      {detail::accessibility_from_props(
                          props, ::ui::SemanticRole::Auto)} callbacks = {
                          detail::callbacks_from_props(
                              props)} children = {props.children} />
}

} // namespace

const ::ui::Component<BoxProps> Box{"Box", render_box};

} // namespace ui::components
