UiElement BuildGeneratedRetainedTree(int write) {
  return <Box key="generated" style={Style{.width = Length::points(240.0f), .height = Length::points(120.0f), .align_items = AlignItems::Start, .padding = EdgeSizes{4.0f, 4.0f, 8.0f, 8.0f}, .gap = 6.0f}}>
