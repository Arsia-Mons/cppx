            "type": "SYMBOL",
            "name": "jsx_attribute"
          }
        },
        {
          "type": "STRING",
          "value": "/>"
        }
      ]
    },
    "_child": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "jsx_element"
        },
        {
          "type": "SYMBOL",
          "name": "jsx_self_closing_element"
        },
        {
          "type": "SYMBOL",
          "name": "jsx_expression"
        },
        {
          "type": "SYMBOL",
          "name": "jsx_text"
        }
      ]
    },
    "jsx_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "(<[^A-Za-z_\\/]|[^<{}])+"
        }
      }
    },
    "jsx_expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_expr_item"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "_expr_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "jsx_element"
        },
        {
          "type": "SYMBOL",
          "name": "jsx_self_closing_element"
        },
        {
          "type": "SYMBOL",
          "name": "nested_braces"
        },
        {
          "type": "SYMBOL",
          "name": "expr_text"
        }
      ]
    },
    "nested_braces": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_expr_item"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "expr_text": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "(template\\s*<|\\w<|<[^A-Za-z_\\/{}]|\"(\\\\.|[^\"\\\\])*\"|'(\\\\.|[^'\\\\])*'|[^<{}\"'])+"
        }
      }
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "jsx_attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "attribute_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "="
                },
                {
                  "type": "FIELD",
                  "name": "value",
                  "content": {
                    "type": "SYMBOL",
                    "name": "_attribute_value"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "attribute_name": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_-]*"
    },
    "_attribute_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "jsx_expression"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "string": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "\""
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^\"\\\\\\n]+"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "escape_sequence"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "\""
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": "'"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "PATTERN",
                    "value": "[^'\\\\\\n]+"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "escape_sequence"
                  }
                ]
              }
            },
            {
              "type": "STRING",
              "value": "'"
            }
          ]
        }
      ]
    },
    "escape_sequence": {
      "type": "PATTERN",
      "value": "\\\\."
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r\\n]+"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": []
}
